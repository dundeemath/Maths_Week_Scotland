<script>
(function () {
  "use strict";
  if (window.SHOW_JS_APPS === false) return;

  // -------------------------------------------------------------------
  // Shared library for the three fractal demos below (Barnsley's fern,
  // "building a pattern from first principles", and the Sierpinski
  // triangle extra). Each demo's own <script> block is otherwise
  // independent -- this is the only code they have in common, exposed
  // once here as window.FractalLib so it isn't duplicated three times.
  //
  // Ported 1:1 (same maths, same constants) from the Python/Shinylive
  // version (fractal_app/app.py). Runs as plain JavaScript, entirely in
  // the browser -- no Python runtime to download.
  //
  // Each "rule" is an affine map (x,y) -> (a*x+b*y+e, c*x+d*y+f). The
  // "chaos game" repeatedly picks one of several rules at random (each
  // with a fixed probability) and applies it to wherever the last point
  // landed -- that's the entire mechanism behind every demo below.
  // -------------------------------------------------------------------

  var SEED = 42;
  var CLIP = 1.0e4;

  function fmtN(n) {
    n = Math.round(n);
    var s = String(n);
    var out = "";
    var c = 0;
    for (var i = s.length - 1; i >= 0; i--) {
      out = s[i] + out;
      c++;
      if (c % 3 === 0 && i !== 0) out = "," + out;
    }
    return out;
  }

  // A tiny deterministic PRNG (mulberry32). Re-seeding with the same
  // SEED and drawing n numbers always gives the same first n draws as
  // drawing 2n numbers would -- that's what guarantees that the first
  // N points of a run are always exactly a prefix of a bigger run with
  // the same rules, letting "Watch it build" reveal a real, continuing
  // construction rather than a new random one each frame.
  function makeRng(seed) {
    var s = seed >>> 0;
    return function () {
      s |= 0;
      s = (s + 0x6D2B79F5) | 0;
      var t = Math.imul(s ^ (s >>> 15), 1 | s);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function clipPoint(x, y) {
    var clipped = false;
    if (!isFinite(x)) { x = 0.0; clipped = true; }
    else if (Math.abs(x) > CLIP) { x = CLIP * (x < 0 ? -1 : 1); clipped = true; }
    if (!isFinite(y)) { y = 0.0; clipped = true; }
    else if (Math.abs(y) > CLIP) { y = CLIP * (y < 0 ? -1 : 1); clipped = true; }
    return [x, y, clipped];
  }

  function normalizeProbs(rules) {
    var n = rules.length;
    var raw = rules.map(function (r) { return Math.max(r[6], 0.0); });
    var total = raw.reduce(function (a, b) { return a + b; }, 0);
    if (total <= 0) return rules.map(function () { return 1.0 / n; });
    return raw.map(function (p) { return p / total; });
  }

  function generatePoints(nPoints, rules, seed) {
    var probs = normalizeProbs(rules);
    var cum = [];
    var acc = 0.0;
    for (var i = 0; i < probs.length; i++) { acc += probs[i]; cum.push(acc); }
    cum[cum.length - 1] = 1.0;

    var rng = makeRng(seed === undefined ? SEED : seed);
    var xs = new Array(nPoints);
    var ys = new Array(nPoints);
    var ruleIdx = new Array(nPoints);
    var x = 0.0, y = 0.0;
    var clipped = false;
    for (var n = 0; n < nPoints; n++) {
      var r = rng();
      var k = 0;
      while (r > cum[k]) k++;
      var rule = rules[k];
      var nx = rule[0] * x + rule[1] * y + rule[4];
      var ny = rule[2] * x + rule[3] * y + rule[5];
      var cp = clipPoint(nx, ny);
      nx = cp[0]; ny = cp[1]; clipped = clipped || cp[2];
      x = nx; y = ny;
      xs[n] = x; ys[n] = y; ruleIdx[n] = k;
    }
    return { xs: xs, ys: ys, ruleIdx: ruleIdx, clipped: clipped };
  }

  function dataBounds(xs, ys, from, to) {
    var xmin = Infinity, xmax = -Infinity, ymin = Infinity, ymax = -Infinity;
    for (var i = from; i < to; i++) {
      if (xs[i] < xmin) xmin = xs[i];
      if (xs[i] > xmax) xmax = xs[i];
      if (ys[i] < ymin) ymin = ys[i];
      if (ys[i] > ymax) ymax = ys[i];
    }
    if (!isFinite(xmin)) { xmin = -1; xmax = 1; ymin = -1; ymax = 1; }
    return [xmin, xmax, ymin, ymax];
  }

  function computeTransform(xmin, xmax, ymin, ymax, W, H) {
    var xpad = (xmax - xmin) * 0.06 + 0.05;
    var ypad = (ymax - ymin) * 0.06 + 0.05;
    xmin -= xpad; xmax += xpad; ymin -= ypad; ymax += ypad;
    var dataW = Math.max(xmax - xmin, 1e-6);
    var dataH = Math.max(ymax - ymin, 1e-6);
    var scale = Math.min(W / dataW, H / dataH);
    var offX = (W - dataW * scale) / 2;
    var offY = (H - dataH * scale) / 2;
    return {
      sx: function (x) { return offX + (x - xmin) * scale; },
      sy: function (y) { return H - (offY + (y - ymin) * scale); }
    };
  }

  // Draws points [0, n) from xs/ys onto ctx, optionally coloured by which
  // rule drew each one, optionally highlighting the most recent point.
  function drawPoints(ctx, W, H, xs, ys, ruleIdx, n, colorMode, colors, baseColor, highlightI) {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = "#fbfbf8";
    ctx.fillRect(0, 0, W, H);
    if (n <= 0) return;
    var b = dataBounds(xs, ys, 0, n);
    var tr = computeTransform(b[0], b[1], b[2], b[3], W, H);
    var sz = 1.6;
    var half = sz / 2;

    if (colorMode === "rule") {
      ctx.globalAlpha = 0.65;
      for (var i = 0; i < n; i++) {
        ctx.fillStyle = colors[ruleIdx[i]];
        var px = tr.sx(xs[i]), py = tr.sy(ys[i]);
        ctx.fillRect(px - half, py - half, sz, sz);
      }
    } else {
      ctx.globalAlpha = 0.55;
      ctx.fillStyle = baseColor;
      for (var j = 0; j < n; j++) {
        var qx = tr.sx(xs[j]), qy = tr.sy(ys[j]);
        ctx.fillRect(qx - half, qy - half, sz, sz);
      }
    }
    ctx.globalAlpha = 1.0;

    if (highlightI !== undefined && highlightI !== null && highlightI >= 0 && highlightI < n) {
      var hx = tr.sx(xs[highlightI]), hy = tr.sy(ys[highlightI]);
      if (highlightI > 0) {
        var px2 = tr.sx(xs[highlightI - 1]), py2 = tr.sy(ys[highlightI - 1]);
        ctx.strokeStyle = "#d81b60";
        ctx.lineWidth = 1.0;
        ctx.globalAlpha = 0.85;
        ctx.beginPath();
        ctx.moveTo(px2, py2);
        ctx.lineTo(hx, hy);
        ctx.stroke();
        ctx.globalAlpha = 1.0;
      }
      ctx.beginPath();
      ctx.fillStyle = "#d81b60";
      ctx.arc(hx, hy, 5, 0, 2 * Math.PI);
      ctx.fill();
      ctx.strokeStyle = "#fff";
      ctx.lineWidth = 1.2;
      ctx.stroke();
    }
  }

  function stepFormulaHtml(n, target, rules, ruleIdx, xs, ys, names, probs) {
    var k = ruleIdx[n - 1];
    var r = rules[k];
    var a = r[0], b = r[1], c = r[2], d = r[3], e = r[4], f = r[5];
    var px = n >= 2 ? xs[n - 2] : 0.0, py = n >= 2 ? ys[n - 2] : 0.0;
    var nx = xs[n - 1], ny = ys[n - 1];
    var lines = [];
    lines.push("<strong>Step " + fmtN(n) + " of " + fmtN(target) + "</strong> -- this point was drawn by the " +
      "<strong>" + names[k] + "</strong> rule (chosen with probability " + Math.round(probs[k] * 100) + "%):");
    lines.push(
      "x = " + a.toFixed(2) + " &times; " + px.toFixed(3) + " + " + b.toFixed(2) + " &times; " + py.toFixed(3) +
      " + " + e.toFixed(2) + " = <strong>" + nx.toFixed(3) + "</strong><br>" +
      "y = " + c.toFixed(2) + " &times; " + px.toFixed(3) + " + " + d.toFixed(2) + " &times; " + py.toFixed(3) +
      " + " + f.toFixed(2) + " = <strong>" + ny.toFixed(3) + "</strong>"
    );
    return lines.join("<br><br>");
  }

  // A "watch it build" controller: reveals `target` points one at a time
  // for the first `slowPoints`, with a short narrated formula each time,
  // then in a fixed number of fast batches for the rest -- exactly the
  // slow-then-fast pacing of the original app. The batch size in the fast
  // phase is fixed by the FIXED amount of work left (target - slowPoints)
  // divided across fastFrames ticks, so it always finishes in that many
  // ticks regardless of target size.
  function makeWatchBuilder(opts) {
    var slowPoints = opts.slowPoints, slowDelay = opts.slowDelay;
    var fastFrames = opts.fastFrames, fastDelay = opts.fastDelay;
    var onReveal = opts.onReveal; // (revealed, animating) -> void
    var targetFn = opts.targetFn;
    var timerId = null;
    var animating = false;
    var revealed = 0;

    function stop() {
      animating = false;
      if (timerId !== null) { clearTimeout(timerId); timerId = null; }
    }

    function tick() {
      if (!animating) return;
      var target = targetFn();
      var current = revealed;
      var delay, newN;
      if (current < Math.min(slowPoints, target)) {
        delay = slowDelay;
        newN = current + 1;
      } else {
        delay = fastDelay;
        var fastTotal = Math.max(target - slowPoints, 1);
        var step = Math.max(1, Math.ceil(fastTotal / fastFrames));
        newN = Math.min(current + step, target);
      }
      revealed = newN;
      onReveal(revealed, true);
      if (newN >= target) { animating = false; timerId = null; return; }
      timerId = setTimeout(tick, delay);
    }

    function start() {
      stop();
      revealed = 0;
      animating = true;
      timerId = setTimeout(tick, slowDelay);
    }

    // Fast, non-narrated rebuild used whenever a slider changes without
    // pressing "watch it build": grows to the target in batches of a
    // few thousand points per animation frame via requestAnimationFrame,
    // so a change never draws tens of thousands of points synchronously
    // in one go (which can jank a phone's browser).
    function fastRebuild(batchSize) {
      stop();
      var target = targetFn();
      revealed = 0;
      function frame() {
        revealed = Math.min(revealed + batchSize, target);
        onReveal(revealed, false);
        if (revealed < target) {
          timerId = requestAnimationFrame(frame);
        } else {
          timerId = null;
        }
      }
      timerId = requestAnimationFrame(frame);
    }

    function jumpTo(n) {
      stop();
      revealed = n;
      onReveal(revealed, false);
    }

    return {
      start: start, stop: stop, fastRebuild: fastRebuild, jumpTo: jumpTo,
      isAnimating: function () { return animating; },
      getRevealed: function () { return revealed; }
    };
  }

  window.FractalLib = {
    SEED: SEED, CLIP: CLIP,
    fmtN: fmtN, makeRng: makeRng, clipPoint: clipPoint,
    normalizeProbs: normalizeProbs, generatePoints: generatePoints,
    dataBounds: dataBounds, computeTransform: computeTransform,
    drawPoints: drawPoints, stepFormulaHtml: stepFormulaHtml,
    makeWatchBuilder: makeWatchBuilder
  };
})();
</script>
```

