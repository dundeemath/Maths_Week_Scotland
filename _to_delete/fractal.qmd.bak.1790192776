<div id="fern-app" class="fractal-app">

  <div class="fern-card">
    <div class="fern-row">
      <div class="fern-sidebar">
        <h6>Number of points</h6>
        <input id="fern-s3-n" type="range" min="1000" max="40000" step="1000" value="15000">
        <div class="fern-btn-row">
          <button id="fern-s3-animate" class="fern-btn-primary" type="button">Watch it build, point by point</button>
        </div>
        <hr>
        <h6>Colour</h6>
        <div class="fern-radio">
          <label><input type="radio" name="fern-s3-color" value="natural" checked> Natural green</label>
          <label><input type="radio" name="fern-s3-color" value="rule"> By generating rule (see the self-similarity)</label>
        </div>
        <hr>
        <h6>Shape</h6>
        <label for="fern-s3-rotation">Leaflet rotation: <strong id="fern-s3-rotation-val">0</strong>&deg;</label>
        <input id="fern-s3-rotation" type="range" min="-45" max="45" step="1" value="0">
        <label for="fern-s3-leaflet">Leaflet size: <strong id="fern-s3-leaflet-val">1.0</strong></label>
        <input id="fern-s3-leaflet" type="range" min="0.2" max="7.0" step="0.1" value="1.0">
        <label for="fern-s3-stem">Stem length: <strong id="fern-s3-stem-val">1.0</strong></label>
        <input id="fern-s3-stem" type="range" min="0.2" max="5.0" step="0.1" value="1.0">
        <label for="fern-s3-lean">Overall lean: <strong id="fern-s3-lean-val">0.0</strong></label>
        <input id="fern-s3-lean" type="range" min="-4.0" max="4.0" step="0.1" value="0.0">
        <div class="fern-btn-row">
          <button id="fern-s3-reset" class="fern-btn-secondary" type="button">Reset to Barnsley's fern</button>
        </div>
      </div>
      <div class="fern-canvas-wrap">
        <canvas id="fern-canvas" width="640" height="700"></canvas>
        <div id="fern-s3-summary" class="fern-summary"></div>
        <details class="fern-rules-table">
          <summary>See the raw numbers these four knobs produce</summary>
          <ul id="fern-s3-rules-list"></ul>
        </details>
      </div>
    </div>
  </div>

</div>

<script>
(function () {
  "use strict";
  if (window.SHOW_JS_APPS === false) return;
  var lib = window.FractalLib;
  if (!lib) return;

  var root = document.getElementById("fern-app");
  if (!root) return;
  function $(id) { return root.querySelector("#" + id); }

  var CLASSIC_RULES = [
    [0.00, 0.00, 0.00, 0.16, 0.00, 0.00, 0.01],
    [0.85, 0.04, -0.04, 0.85, 0.00, 1.60, 0.85],
    [0.20, -0.26, 0.23, 0.22, 0.00, 1.60, 0.07],
    [-0.15, 0.28, 0.26, 0.24, 0.00, 0.44, 0.07]
  ];
  var RULE_NAMES = ["Stem", "Whole-fern copy", "Left leaflet", "Right leaflet"];
  var RULE_COLORS = ["#6b4226", "#2e7d32", "#1565c0", "#c77f00"];
  var SLOW_POINTS = 240, SLOW_DELAY = 100, FAST_FRAMES = 50, FAST_DELAY = 50;

  var canvas = $("fern-canvas");
  var ctx = canvas.getContext("2d");
  var nSlider = $("fern-s3-n");
  var animateBtn = $("fern-s3-animate");
  var resetBtn = $("fern-s3-reset");
  var summaryEl = $("fern-s3-summary");
  var rulesListEl = $("fern-s3-rules-list");
  var rotationSlider = $("fern-s3-rotation"), leafletSlider = $("fern-s3-leaflet");
  var stemSlider = $("fern-s3-stem"), leanSlider = $("fern-s3-lean");
  var rotationVal = $("fern-s3-rotation-val"), leafletVal = $("fern-s3-leaflet-val");
  var stemVal = $("fern-s3-stem-val"), leanVal = $("fern-s3-lean-val");
  var colorRadios = root.querySelectorAll('input[name="fern-s3-color"]');

  function colorMode() {
    var checked = root.querySelector('input[name="fern-s3-color"]:checked');
    return checked ? checked.value : "natural";
  }

  function simplifiedRules(rotationDeg, leafletScale, stemMult, lean) {
    var rules = CLASSIC_RULES.map(function (r) { return r.slice(); });
    rules[0][3] = CLASSIC_RULES[0][3] * stemMult;
    rules[1][1] = CLASSIC_RULES[1][1] + lean;
    var theta = rotationDeg * Math.PI / 180;
    var ct = Math.cos(theta), st = Math.sin(theta);
    [2, 3].forEach(function (i) {
      var a = CLASSIC_RULES[i][0], b = CLASSIC_RULES[i][1], c = CLASSIC_RULES[i][2], d = CLASSIC_RULES[i][3];
      rules[i][0] = (ct * a - st * c) * leafletScale;
      rules[i][1] = (ct * b - st * d) * leafletScale;
      rules[i][2] = (st * a + ct * c) * leafletScale;
      rules[i][3] = (st * b + ct * d) * leafletScale;
    });
    return rules;
  }

  function currentRules() {
    return simplifiedRules(
      parseFloat(rotationSlider.value), parseFloat(leafletSlider.value),
      parseFloat(stemSlider.value), parseFloat(leanSlider.value)
    );
  }

  function target() { return parseInt(nSlider.value, 10); }

  function updateSliderLabels() {
    rotationVal.textContent = parseFloat(rotationSlider.value).toFixed(0);
    leafletVal.textContent = parseFloat(leafletSlider.value).toFixed(1);
    stemVal.textContent = parseFloat(stemSlider.value).toFixed(1);
    leanVal.textContent = parseFloat(leanSlider.value).toFixed(1);
  }

  function updateRulesTable(rules, probs) {
    var html = "";
    for (var i = 0; i < RULE_NAMES.length; i++) {
      var r = rules[i];
      html += "<li><strong>" + RULE_NAMES[i] + "</strong>: a=" + r[0].toFixed(3) + ", b=" + r[1].toFixed(3) +
        ", c=" + r[2].toFixed(3) + ", d=" + r[3].toFixed(3) + ", e=" + r[4].toFixed(3) + ", f=" + r[5].toFixed(3) +
        ", p=" + Math.round(probs[i] * 100) + "%</li>";
    }
    rulesListEl.innerHTML = html;
  }

  function onReveal(revealed, animating) {
    updateSliderLabels();
    var n = Math.max(revealed, 1);
    var rules = currentRules();
    var res = lib.generatePoints(n, rules, lib.SEED);
    var highlightI = (animating && revealed >= 1) ? revealed - 1 : null;
    lib.drawPoints(ctx, canvas.width, canvas.height, res.xs, res.ys, res.ruleIdx, n, colorMode(), RULE_COLORS, "#2f7a3d", highlightI);

    var probs = lib.normalizeProbs(rules);
    var lines = [];
    if (animating && revealed >= 1 && revealed <= SLOW_POINTS) {
      lines.push(lib.stepFormulaHtml(revealed, target(), rules, res.ruleIdx, res.xs, res.ys, RULE_NAMES, probs));
    } else if (animating) {
      lines.push("<strong>Building the fern: " + lib.fmtN(revealed) + " / " + lib.fmtN(target()) + " points</strong>");
    } else {
      lines.push("<strong>Points plotted:</strong> " + lib.fmtN(revealed));
    }

    if (res.clipped) {
      lines.push("<strong>These settings don't contract</strong> -- points are shooting off to huge values and being capped so the app doesn't crash. Try a smaller leaflet size or a smaller lean, or press \"Reset to Barnsley's fern\".");
    }

    var ruleLines = RULE_NAMES.map(function (name, i) {
      return "&bull; <strong>" + name + "</strong>: " + Math.round(probs[i] * 100) + "%";
    }).join("<br>");
    lines.push("Every point is drawn by picking one of 4 rules at random, each with a fixed probability, then plotting where it sends the previous point:<br>" + ruleLines);
    lines.push("On Barnsley's own numbers, the <strong>whole-fern copy</strong> rule alone (picked 85% of the time) draws a complete smaller copy of the entire fern -- the same self-similarity idea explained further down the page, just with cleverer rules.");
    if (colorMode() === "rule") {
      lines.push("Colours above show which rule drew each point.");
    }

    summaryEl.innerHTML = lines.join("<br><br>");
    updateRulesTable(rules, probs);
  }

  var builder = lib.makeWatchBuilder({
    slowPoints: SLOW_POINTS, slowDelay: SLOW_DELAY,
    fastFrames: FAST_FRAMES, fastDelay: FAST_DELAY,
    onReveal: onReveal, targetFn: target
  });

  nSlider.addEventListener("input", function () { builder.fastRebuild(3000); });
  animateBtn.addEventListener("click", function () { builder.start(); });
  [rotationSlider, leafletSlider, stemSlider, leanSlider].forEach(function (s) {
    s.addEventListener("input", function () { builder.fastRebuild(3000); });
  });
  colorRadios.forEach(function (r) {
    r.addEventListener("change", function () { onReveal(builder.getRevealed(), builder.isAnimating()); });
  });
  resetBtn.addEventListener("click", function () {
    rotationSlider.value = 0; leafletSlider.value = 1.0; stemSlider.value = 1.0; leanSlider.value = 0.0;
    builder.fastRebuild(3000);
  });

  builder.start();
})();
</script>
```
:::

---

## Building a pattern from first principles

If you're curious how the simulation above works, here's the same idea unpacked in two simpler steps, starting with just one point and one rule.

A **rule** takes a point (x, y) and maps it to a new point (x′, y′) = (a·x + b·y + e, c·x + d·y + f). That's it -- six numbers, one point in, one point out. Try the sliders, then press "Apply this rule again" to feed the new point back into the same rule, and watch where it goes next.

::: {#fig-fractal-firstprinciples .content-hidden when-format="pdf"}
```{=html}
<div id="firstprinciples-app" class="fractal-app">

  <div class="fern-card">
    <div class="fern-row">
      <div class="fern-sidebar">
        <h6>Starting point</h6>
        <label for="fp-x0">x</label>
        <input id="fp-x0" type="number" step="0.1" value="1.0">
        <label for="fp-y0">y</label>
        <input id="fp-y0" type="number" step="0.1" value="1.0">
        <h6 style="margin-top:10px;">The rule</h6>
        <label for="fp-a">a: <strong id="fp-a-val">0.70</strong></label>
        <input id="fp-a" type="range" min="-1.5" max="1.5" step="0.05" value="0.70">
        <label for="fp-b">b: <strong id="fp-b-val">-0.50</strong></label>
        <input id="fp-b" type="range" min="-1.5" max="1.5" step="0.05" value="-0.50">
        <label for="fp-c">c: <strong id="fp-c-val">0.50</strong></label>
        <input id="fp-c" type="range" min="-1.5" max="1.5" step="0.05" value="0.50">
        <label for="fp-d">d: <strong id="fp-d-val">0.70</strong></label>
        <input id="fp-d" type="range" min="-1.5" max="1.5" step="0.05" value="0.70">
        <label for="fp-e">e: <strong id="fp-e-val">0.40</strong></label>
        <input id="fp-e" type="range" min="-2.0" max="2.0" step="0.1" value="0.40">
        <label for="fp-f">f: <strong id="fp-f-val">0.20</strong></label>
        <input id="fp-f" type="range" min="-2.0" max="2.0" step="0.1" value="0.20">
        <div class="fern-btn-row">
          <button id="fp-apply" class="fern-btn-primary" type="button">Apply this rule again</button>
          <button id="fp-reset" class="fern-btn-secondary" type="button">Reset</button>
        </div>
        <div id="fp-summary" class="fern-summary"></div>
      </div>
      <div class="fern-canvas-wrap">
        <canvas id="fp-canvas" width="480" height="420"></canvas>
      </div>
    </div>
  </div>

</div>

<script>
(function () {
  "use strict";
  if (window.SHOW_JS_APPS === false) return;
  var lib = window.FractalLib;
  if (!lib) return;

  var root = document.getElementById("firstprinciples-app");
  if (!root) return;
  function $(id) { return root.querySelector("#" + id); }

  // A single rule, applied to itself over and over: (x,y) -> (a*x+b*y+e, c*x+d*y+f).
  function iterateSingleRule(x0, y0, a, b, c, d, e, f, n) {
    var xs = [x0], ys = [y0];
    var clipped = false;
    var x = x0, y = y0;
    for (var i = 0; i < n; i++) {
      var nx = a * x + b * y + e;
      var ny = c * x + d * y + f;
      var r = lib.clipPoint(nx, ny);
      nx = r[0]; ny = r[1]; clipped = clipped || r[2];
      xs.push(nx); ys.push(ny);
      x = nx; y = ny;
    }
    return { xs: xs, ys: ys, clipped: clipped };
  }

  var canvas = $("fp-canvas");
  var ctx = canvas.getContext("2d");
  var summaryEl = $("fp-summary");
  var x0In = $("fp-x0"), y0In = $("fp-y0");
  var sliders = {
    a: $("fp-a"), b: $("fp-b"), c: $("fp-c"),
    d: $("fp-d"), e: $("fp-e"), f: $("fp-f")
  };
  var vals = {
    a: $("fp-a-val"), b: $("fp-b-val"), c: $("fp-c-val"),
    d: $("fp-d-val"), e: $("fp-e-val"), f: $("fp-f-val")
  };
  var applyBtn = $("fp-apply"), resetBtn = $("fp-reset");
  var count = 0;

  function safe(v, dflt) { var n = parseFloat(v); return isFinite(n) ? n : dflt; }

  function render() {
    var x0 = safe(x0In.value, 1.0), y0 = safe(y0In.value, 1.0);
    var a = safe(sliders.a.value, 0), b = safe(sliders.b.value, 0);
    var c = safe(sliders.c.value, 0), d = safe(sliders.d.value, 0);
    var e = safe(sliders.e.value, 0), f = safe(sliders.f.value, 0);
    for (var k in vals) vals[k].textContent = safe(sliders[k].value, 0).toFixed(2);

    var res = iterateSingleRule(x0, y0, a, b, c, d, e, f, count);
    var xs = res.xs, ys = res.ys;

    var W = canvas.width, H = canvas.height;
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = "#fbfbf8";
    ctx.fillRect(0, 0, W, H);
    var b2 = lib.dataBounds(xs, ys, 0, xs.length);
    var xpad = (b2[1] - b2[0]) * 0.15 + 0.4, ypad = (b2[3] - b2[2]) * 0.15 + 0.4;
    var tr = (function () {
      var xmin = b2[0] - xpad, xmax = b2[1] + xpad, ymin = b2[2] - ypad, ymax = b2[3] + ypad;
      var dataW = Math.max(xmax - xmin, 1e-6), dataH = Math.max(ymax - ymin, 1e-6);
      var scale = Math.min(W / dataW, H / dataH);
      var offX = (W - dataW * scale) / 2, offY = (H - dataH * scale) / 2;
      return {
        sx: function (x) { return offX + (x - xmin) * scale; },
        sy: function (y) { return H - (offY + (y - ymin) * scale); }
      };
    })();

    // guide lines through the origin
    ctx.strokeStyle = "#e3e3e3"; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(0, tr.sy(0)); ctx.lineTo(W, tr.sy(0)); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(tr.sx(0), 0); ctx.lineTo(tr.sx(0), H); ctx.stroke();

    // connecting line
    ctx.strokeStyle = "#9aa0a6"; ctx.globalAlpha = 0.7; ctx.lineWidth = 1.0;
    ctx.beginPath();
    for (var i = 0; i < xs.length; i++) {
      var px = tr.sx(xs[i]), py = tr.sy(ys[i]);
      if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    }
    ctx.stroke();
    ctx.globalAlpha = 1.0;

    // intermediate points
    if (xs.length > 2) {
      ctx.fillStyle = "#9aa0a6";
      for (var j = 1; j < xs.length - 1; j++) {
        var qx = tr.sx(xs[j]), qy = tr.sy(ys[j]);
        ctx.beginPath(); ctx.arc(qx, qy, 3, 0, 2 * Math.PI); ctx.fill();
      }
    }
    // start point (black) and current point (pink)
    ctx.fillStyle = "#222";
    ctx.beginPath(); ctx.arc(tr.sx(xs[0]), tr.sy(ys[0]), 5, 0, 2 * Math.PI); ctx.fill();
    if (xs.length > 1) {
      ctx.fillStyle = "#d81b60";
      ctx.beginPath();
      ctx.arc(tr.sx(xs[xs.length - 1]), tr.sy(ys[ys.length - 1]), 5.5, 0, 2 * Math.PI);
      ctx.fill();
    }

    var lines = [];
    if (count === 0) {
      lines.push('Press "Apply this rule again" to map the black point using the rule above -- the new point will appear in pink.');
    } else {
      var px2 = xs[xs.length - 2], py2 = ys[ys.length - 2];
      var nx = xs[xs.length - 1], ny = ys[ys.length - 1];
      lines.push("<strong>After " + count + " application" + (count !== 1 ? "s" : "") + " of the rule:</strong>");
      lines.push(
        "x&prime; = " + a.toFixed(2) + " &times; " + px2.toFixed(3) + " + " + b.toFixed(2) + " &times; " + py2.toFixed(3) +
        " + " + e.toFixed(2) + " = <strong>" + nx.toFixed(3) + "</strong><br>" +
        "y&prime; = " + c.toFixed(2) + " &times; " + px2.toFixed(3) + " + " + d.toFixed(2) + " &times; " + py2.toFixed(3) +
        " + " + f.toFixed(2) + " = <strong>" + ny.toFixed(3) + "</strong>"
      );
      if (res.clipped) {
        lines.push("This rule doesn't contract -- the point is shooting off to huge values (capped here so the plot doesn't break). Try smaller a/b/c/d values, or press reset.");
      } else if (count >= 5) {
        lines.push("Notice the point is settling towards one fixed spot rather than wandering off -- that's what it means for a rule to <strong>contract</strong>. Every rule used below is built to do exactly this.");
      }
    }
    summaryEl.innerHTML = lines.join("<br><br>");
  }

  applyBtn.addEventListener("click", function () { count = Math.min(count + 1, 30); render(); });
  resetBtn.addEventListener("click", function () { count = 0; render(); });
  x0In.addEventListener("input", render);
  y0In.addEventListener("input", render);
  Object.keys(sliders).forEach(function (k) { sliders[k].addEventListener("input", render); });

  render();
})();
</script>
```
:::

---

## Extra: Sierpinski's triangle

Fractals don't use one fixed rule -- they repeat a simple recipe, over and over: start at any point; pick one of the triangle's three corners at random, each equally likely; move the current point exactly halfway towards that corner, and plot the new point; then repeat, tens of thousands of times. Do that, and out comes the famous **Sierpinski triangle**.

(This "halfway to a random corner" trick is special to the triangle -- try it on a square and you just get a solidly filled square, not a fractal. The fern further up the page gets its fractal structure a different way, using rules that rotate and stretch as well as shrink.)

::: {#fig-fractal-sierpinski .content-hidden when-format="pdf"}
```{=html}
<div id="sierpinski-app" class="fractal-app">

  <div class="fern-card">
    <div class="fern-row">
      <div class="fern-sidebar">
        <h6>Number of points</h6>
        <input id="sp-n" type="range" min="500" max="8000" step="500" value="4000">
        <div class="fern-btn-row">
          <button id="sp-animate" class="fern-btn-primary" type="button">Watch it build, point by point</button>
        </div>
        <div id="sp-summary" class="fern-summary"></div>
      </div>
      <div class="fern-canvas-wrap">
        <canvas id="sp-canvas" width="480" height="420"></canvas>
      </div>
    </div>
  </div>

</div>

<script>
(function () {
  "use strict";
  if (window.SHOW_JS_APPS === false) return;
  var lib = window.FractalLib;
  if (!lib) return;

  var root = document.getElementById("sierpinski-app");
  if (!root) return;
  function $(id) { return root.querySelector("#" + id); }

  var TRIANGLE_CORNERS = [[0.0, 0.0], [1.0, 0.0], [0.5, 0.866]];
  var TRIANGLE_NAMES = ["Corner A", "Corner B", "Corner C"];
  var TRIANGLE_COLORS = ["#c0392b", "#2e7d32", "#1565c0"];
  var TRIANGLE_RULES = TRIANGLE_CORNERS.map(function (c) {
    return [0.5, 0.0, 0.0, 0.5, c[0] / 2, c[1] / 2, 1.0 / 3.0];
  });
  var SLOW_POINTS_2 = 18, SLOW_DELAY_2 = 300, FAST_FRAMES_2 = 12, FAST_DELAY_2 = 100;

  var canvas = $("sp-canvas");
  var ctx = canvas.getContext("2d");
  var nSlider = $("sp-n");
  var animateBtn = $("sp-animate");
  var summaryEl = $("sp-summary");

  function target() { return parseInt(nSlider.value, 10); }

  function onReveal(revealed, animating) {
    var n = Math.max(revealed, 1);
    var res = lib.generatePoints(n, TRIANGLE_RULES, lib.SEED);
    var highlightI = (animating && revealed >= 1) ? revealed - 1 : null;
    lib.drawPoints(ctx, canvas.width, canvas.height, res.xs, res.ys, res.ruleIdx, n, "rule", TRIANGLE_COLORS, null, highlightI);

    var probs = lib.normalizeProbs(TRIANGLE_RULES);
    var lines = [];
    if (animating && revealed >= 1 && revealed <= SLOW_POINTS_2) {
      lines.push(lib.stepFormulaHtml(revealed, target(), TRIANGLE_RULES, res.ruleIdx, res.xs, res.ys, TRIANGLE_NAMES, probs));
    } else if (animating) {
      lines.push("<strong>Building the triangle: " + lib.fmtN(revealed) + " / " + lib.fmtN(target()) + " points</strong>");
    } else {
      lines.push("<strong>Points plotted:</strong> " + lib.fmtN(revealed));
    }
    summaryEl.innerHTML = lines.join("<br><br>");
  }

  var builder = lib.makeWatchBuilder({
    slowPoints: SLOW_POINTS_2, slowDelay: SLOW_DELAY_2,
    fastFrames: FAST_FRAMES_2, fastDelay: FAST_DELAY_2,
    onReveal: onReveal, targetFn: target
  });

  nSlider.addEventListener("input", function () { builder.fastRebuild(1500); });
  animateBtn.addEventListener("click", function () { builder.start(); });

  builder.fastRebuild(1500);
})();
</script>
```
:::

:::
