project:
  type: book

book:
  title: "Mathematics Trail at the University of Dundee Botanic Gardens"
  # Reorder this list for the exhibition -- it's the single source of
  # truth for chapter order (no separate file to keep in sync).
  chapters:
    - index.qmd  
    - phyllotaxis.qmd      # Phyllotaxis
    - spirals.qmd           # Logarithmic Spiral
    - symmetry.qmd         # Symmetry in Plants
    - fractal.qmd          # Fractal
    - circadian.qmd        # Circadian Rhythm
    - fibonacci.qmd        # Fibonacci Numbers
    - birdsong.qmd         # Bird Song
    - analemma.qmd        # The Analemma Project
    - trigonometry.qmd     # Estimating the Height of a Tree using Trigonometry
    - curvature.qmd        # Why leaves crinkle: differential growth in a disc
    - salesman.qmd         # The Travelling Salesman Problem [pure JS app]
    - helicopter.qmd       # Helicopter Seeds
    - konigsberg.qmd       # Seven Bridges of Koenigsberg (currently just a stub, "Topic in Graph Theory.")
    - questionnaire.qmd    # End of Maths Trail Questionnaire (interactive form -- drop, or paper version?)

format:
  html:
    theme: cosmo
    css: mobile.css
    include-in-header: js_apps_switch.html
    toc: false
    number-sections: false
  pdf:
    documentclass: scrbook
    # oneside: without this, scrbook's default twoside layout forces every
    # chapter to start on a fresh right-hand (odd) page, which is what was
    # inserting a blank page after every 1-page chapter. oneside makes
    # chapters run straight on, back to back.
    classoption: [oneside]
    toc: false
    number-sections: false
    # Figures were all printing as "Figure 1" -- scrbook resets its native
    # figure counter at every \chapter, and since most chapters only have
    # one figure, they all landed on the same number. Chapters and sections
    # aren't numbered anywhere else in this book (number-sections: false,
    # no toc), so a bare figure number wouldn't tie to anything -- simplest
    # fix is to drop the "Figure N:" label entirely and keep just the
    # caption text.
    include-in-header:
      text: |
        \usepackage{caption}
        \captionsetup[figure]{labelformat=empty}
        % The trail-map symbols now appear in chapter titles (front matter
        % `title:` fields), which -- unlike the interactive JS apps -- are
        % NOT hidden from PDF output. Plain pdflatex doesn't know how to
        % typeset these Unicode math characters on its own and silently
        % drops/garbles them; newunicodechar tells it exactly what to draw
        % for each one. Add a new \newunicodechar line here if a future
        % trail-map symbol gets added to a title and turns up blank/wrong
        % in the PDF.
        \usepackage{amssymb}
        \usepackage{newunicodechar}
        \newunicodechar{∅}{\ensuremath{\varnothing}}
        \newunicodechar{≤}{\ensuremath{\leq}}
        \newunicodechar{≥}{\ensuremath{\geq}}
        \newunicodechar{≠}{\ensuremath{\neq}}
        \newunicodechar{±}{\ensuremath{\pm}}
        \newunicodechar{√}{\ensuremath{\surd}}
        \newunicodechar{Ω}{\ensuremath{\Omega}}
        \newunicodechar{Σ}{\ensuremath{\Sigma}}
        \newunicodechar{σ}{\ensuremath{\sigma}}
        \newunicodechar{φ}{\ensuremath{\varphi}}
        \newunicodechar{π}{\ensuremath{\pi}}
        \newunicodechar{μ}{\ensuremath{\mu}}
        \newunicodechar{ˣ}{\textsuperscript{x}}
