    color: #fff;
    border: none;
    margin-bottom: 14px;
  }
  #tsp-app button#tsp-clear:active {
    background: #245e3d;
  }
  #tsp-app fieldset {
    border: none;
    padding: 0;
    margin: 0 0 12px 0;
  }
  #tsp-app label {
    display: block;
    font-size: 13px;
    line-height: 1.4;
    cursor: pointer;
    margin: 4px 0;
  }
  #tsp-app label input[type="radio"] {
    margin-right: 6px;
    vertical-align: middle;
  }
  #tsp-app #tsp-summary {
    font-size: 13px;
    line-height: 1.55;
    white-space: pre-line;
  }
  #tsp-canvas {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 6px;
    cursor: pointer;
    touch-action: none;
  }
  @media (max-width: 520px) {
    #tsp-app { gap: 8px; }
    #tsp-app .tsp-canvas-wrap { flex-basis: 100%; order: 1; max-width: 100%; margin: 0 auto; }
    #tsp-app .tsp-sidebar { flex-basis: 100%; order: 2; }
    #tsp-app h5 { font-size: 12px; }
    #tsp-app #tsp-status, #tsp-app #tsp-summary { font-size: 12px; }
    #tsp-app button#tsp-clear { padding: 8px 16px; font-size: 13px; }
  }
</style>

<div id="tsp-app">
  <div class="tsp-canvas-wrap">
    <canvas id="tsp-canvas" width="1856" height="696"></canvas>
  </div>
  <div class="tsp-sidebar">
    <h5>Plan the middle leg</h5>
    <div id="tsp-status">Your route always starts at &Omega; Circadian Rhythm and ends at &mu; Travelling Salesman. Tap the six stops in between (&le;, &radic;, &ge;, &sigma;, &ne;, &phi;), in whatever order you think gives the shortest route.</div>
    <button id="tsp-clear" type="button">Clear my route</button>
    <fieldset>
      <label><input type="radio" name="tsp-show" value="manual" checked> Show: your route</label>
      <label><input type="radio" name="tsp-show" value="optimal"> Show: optimal route</label>
    </fieldset>
    <div id="tsp-summary"></div>
  </div>
</div>

<script>
(function () {
  "use strict";
  if (window.SHOW_JS_APPS === false) return;

  var root = document.getElementById("tsp-app");
  if (!root) return;

  // -------------------------------------------------------------------
  // Travelling Salesman mini-game, ported 1:1 from the Python/Shinylive
  // version (PythonForApps/salesman_py.qmd) to plain JavaScript +
  // <canvas>. Runs entirely in the browser, no Python runtime required.
  //
  // Eight trail stops, read directly off the full, un-cropped, landscape
  // trail map (tsp_trail_map_landscape.png -- a plain copy of Philip's
  // "UpdatedTrailMap.png", used as-is with no recolouring or editing).
  // Pixel coordinates were found by detecting each badge's blue circle
  // in the image (OpenCV colour-blob + contour detection) and confirmed
  // visually against a contact sheet of crops, not eyeballed.
  //
  // stop 0 (Omega) is the fixed START, stop 7 (mu, Travelling Salesman)
  // is the fixed END. The player's job is to find the shortest order to
  // visit the six stops in between -- with 6 stops to permute there are
  // 720 possible orderings, still few enough to check every single one,
  // which is exactly what "optimal route" does.
  // -------------------------------------------------------------------

  var STOPS = [
    [728.0, 334.5],   // 0. Omega -- START (fixed), Native Area
    [837.0, 461.0],   // 1. <= (Lower Pond)
    [1175.5, 331.0],  // 2. sqrt (American Area)
    [1441.0, 495.0],  // 3. >= (Australia and New Zealand Area)
    [350.0, 327.0],   // 4. sigma (Mediterranean Area)
    [1651.0, 486.5],  // 5. != (Asian Area)
    [1783.0, 361.5],  // 6. phi (Asian Area)
    [1208.5, 463.0]   // 7. mu -- Travelling Salesman -- END (fixed)
  ];
  var START_IDX = 0;
  var END_IDX = 7;
  var MIDDLE_IDXS = [1, 2, 3, 4, 5, 6];
  var CIRCLE_R = 26;
  var CLICK_TOLERANCE = CIRCLE_R + 12;

  function dist(a, b) {
    return Math.hypot(STOPS[a][0] - STOPS[b][0], STOPS[a][1] - STOPS[b][1]);
  }

  function openRouteLength(order) {
    var total = 0;
    for (var i = 0; i < order.length - 1; i++) total += dist(order[i], order[i + 1]);
    return total;
  }

  function permutations(arr) {
    if (arr.length <= 1) return [arr];
    var result = [];
    for (var i = 0; i < arr.length; i++) {
      var rest = arr.slice(0, i).concat(arr.slice(i + 1));
      permutations(rest).forEach(function (p) { result.push([arr[i]].concat(p)); });
    }
    return result;
  }

  function bestMiddleOrder() {
    var best = null, bestLen = Infinity;
    permutations(MIDDLE_IDXS).forEach(function (perm) {
      var order = [START_IDX].concat(perm).concat([END_IDX]);
      var len = openRouteLength(order);
      if (len < bestLen) { bestLen = len; best = order; }
    });
    return { order: best, length: bestLen };
  }

  var OPTIMAL = bestMiddleOrder();

  function nearestStop(cx, cy) {
    var bestI = null, bestD = CLICK_TOLERANCE;
    for (var i = 0; i < STOPS.length; i++) {
      var d = Math.hypot(STOPS[i][0] - cx, STOPS[i][1] - cy);
      if (d < bestD) { bestI = i; bestD = d; }
    }
    return bestI;
  }

  function init() {
    var canvas = root.querySelector("#tsp-canvas");
    var ctx = canvas.getContext("2d");
    var statusDiv = root.querySelector("#tsp-status");
    var summaryDiv = root.querySelector("#tsp-summary");
    var clearBtn = root.querySelector("#tsp-clear");
    var showRadios = root.querySelectorAll('input[name="tsp-show"]');

    var img = new Image();
    var imgReady = false;
    var manualRoute = []; // indices of MIDDLE_IDXS the player has tapped, in order

    function currentShow() {
      var checked = root.querySelector('input[name="tsp-show"]:checked');
      return checked ? checked.value : "manual";
    }

    function manualOrder() {
      var complete = manualRoute.length === MIDDLE_IDXS.length;
      return [START_IDX].concat(manualRoute).concat(complete ? [END_IDX] : []);
    }

    function render() {
      if (!imgReady) return;
      var W = canvas.width, H = canvas.height;
      ctx.clearRect(0, 0, W, H);
      ctx.drawImage(img, 0, 0, W, H);

      var show = currentShow();
      var routeToDraw, colour;
      if (show === "optimal") {
        routeToDraw = OPTIMAL.order;
        colour = "#ffb703";
      } else {
        routeToDraw = manualOrder();
        colour = "#1d3557";
      }

      if (routeToDraw.length >= 2) {
        ctx.beginPath();
        ctx.strokeStyle = colour;
        ctx.lineWidth = 4;
        ctx.lineCap = "round";
        ctx.lineJoin = "round";
        for (var i = 0; i < routeToDraw.length; i++) {
          var p = STOPS[routeToDraw[i]];
          if (i === 0) ctx.moveTo(p[0], p[1]); else ctx.lineTo(p[0], p[1]);
        }
        ctx.stroke();
      }

      if (show !== "optimal") {
        manualRoute.forEach(function (idx, orderPos) {
          var p = STOPS[idx];
          var bx = p[0], by = p[1] - 40;
          ctx.beginPath();
          ctx.fillStyle = "#ffffff";
          ctx.strokeStyle = "#1d3557";
          ctx.lineWidth = 2;
          ctx.arc(bx, by, 13, 0, 2 * Math.PI);
          ctx.fill();
          ctx.stroke();
          ctx.fillStyle = "#1d3557";
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          ctx.font = "bold 14px -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif";
          ctx.fillText(String(orderPos + 1), bx, by + 1);
        });
      }

      updateSummary();
    }

    function updateSummary() {
      var lines = [];
      lines.push("Middle stops placed: " + manualRoute.length + " of " + MIDDLE_IDXS.length);
      lines.push("Possible orderings: 720");
      lines.push("");
      lines.push("Optimal route: " + Math.round(OPTIMAL.length) + " units");

      if (manualRoute.length === MIDDLE_IDXS.length) {
        var length = openRouteLength(manualOrder());
        lines.push("Your route: " + Math.round(length) + " units");
        var pct = OPTIMAL.length > 0 ? 100 * (length - OPTIMAL.length) / OPTIMAL.length : 0;
        if (pct > 0.5) {
          lines.push("  " + pct.toFixed(1) + "% longer than optimal");
        } else {
          lines.push("  you found the optimal route!");
        }
      } else {
        lines.push("Tap the six middle stops to complete your route.");
      }
      summaryDiv.textContent = lines.join("\n");
    }

    function handleTap(clientX, clientY) {
      var rect = canvas.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;
      var xCss = clientX - rect.left;
      var yCss = clientY - rect.top;
      var cx = xCss * (canvas.width / rect.width);
      var cy = yCss * (canvas.height / rect.height);

      var idx = nearestStop(cx, cy);
      if (idx === null || idx === START_IDX || idx === END_IDX) return; // start/end are fixed
      if (manualRoute.indexOf(idx) !== -1 || manualRoute.length >= MIDDLE_IDXS.length) return;
      manualRoute.push(idx);
      render();
    }

    canvas.addEventListener("pointerdown", function (evt) {
      evt.preventDefault();
      handleTap(evt.clientX, evt.clientY);
    });

    clearBtn.addEventListener("click", function () {
      manualRoute = [];
      render();
    });

    showRadios.forEach(function (r) {
      r.addEventListener("change", render);
    });

    img.onload = function () {
      imgReady = true;
      render();
    };
    img.src = "tsp_trail_map_landscape.png";
  }

  init();
})();
</script>
```

Tap the six middle stops on the map above to build your route, then switch the sidebar toggle to compare it with the optimal one.
:::

:::
