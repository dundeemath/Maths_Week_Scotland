title: "The Travelling Salesman problem"
format: html
image: 'tsp_game_map.png'
categories: [Combinatorics, Algorithms, Discrete maths, Optimisation]
# tsp_game_map.png is only referenced from inside the raw-HTML/JS app block
# below (img.src = ...), which Quarto's static resource scanner can't see --
# without this, the image never gets copied into _book/ on render.
resources:
  - tsp_game_map.png
---


Between the Fibonacci stop and this one, the trail passes four other stops -- Phyllotaxis, Analemma, Königsberg and Curvature. Suppose you wanted to visit each of the stops once  whilst minimising the distance that you travel.

This is the **Travelling Salesman Problem** (TSP) -- one of the most famous problems in mathematics and computer science. It sounds simple: just try every order of stops and keep the shortest. With 5 stops there are only 12 distinct routes to check. With 10 stops there are already 181,440. With 20 stops there are over 60 quadrillion -- so many that a computer checking a billion routes every single second would still need about two years to get through them all. Trying every option, which works fine for a handful of stops, becomes hopeless almost immediately -- and no computer, however fast, escapes that by brute force alone.


Real versions of this problem sit behind delivery route planning, circuit board drilling, and DNA sequencing. 

::: {.content-hidden when-format="pdf"}


The app below shows six of the trail stops: **φ Fibonacci** (fixed as your start) and **μ Travelling Salesman** (fixed as your end), plus the four stops in between -- Phyllotaxis, Analemma, Königsberg and Curvature. Tap those four, in whichever order you think gives the shortest route from start to end, then use the toggle in the sidebar to compare:

- **Your route** -- the order you tapped the four middle stops in.
- **Optimal route** -- the true shortest order, found by checking all 24 possibilities exactly.

With only four stops to order there are 24 possible routes in total -- small enough to check every single one, which is exactly what the app does for the optimal route. Switch between the two and see how close your guess got.


::: {#fig-tsp .content-hidden when-format="pdf"}
```{=html}
<style>
  #tsp-app, #tsp-app * { box-sizing: border-box; }
  #tsp-app {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: flex-start;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    max-width: 1040px;
    text-align: left;
  }
  #tsp-app .tsp-canvas-wrap {
    flex: 1 1 260px;
    min-width: 0;
    max-width: 420px;
  }
  #tsp-app .tsp-sidebar {
    flex: 1 1 260px;
    min-width: 0;
  }
  #tsp-app h5 {
    margin: 0 0 8px 0;
    font-size: 14px;
  }
  #tsp-app #tsp-status {
    font-size: 13px;
    line-height: 1.5;
    margin-bottom: 12px;
  }
  #tsp-app button#tsp-clear {
    display: inline-block;
    padding: 7px 16px;
    font-size: 13px;
    border-radius: 4px;
    cursor: pointer;
    background: #2f7d4f;
    color: #fff;
    border: none;
    margin-bottom: 14px;
  }
  #tsp-app button#tsp-clear:active {
    background: #245e3d;
  }
  #tsp-app fieldset {
    border: none;
    padding: 0;
    margin: 0 0 12px 0;
  }
  #tsp-app label {
    display: block;
    font-size: 13px;
    line-height: 1.4;
    cursor: pointer;
    margin: 4px 0;
  }
  #tsp-app label input[type="radio"] {
    margin-right: 6px;
    vertical-align: middle;
  }
  #tsp-app #tsp-summary {
    font-size: 13px;
    line-height: 1.55;
    white-space: pre-line;
  }
  #tsp-canvas {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 6px;
    cursor: pointer;
    touch-action: none;
  }
  @media (max-width: 520px) {
    #tsp-app { gap: 8px; }
    #tsp-app .tsp-canvas-wrap { flex-basis: 100%; order: 1; max-width: 320px; margin: 0 auto; }
    #tsp-app .tsp-sidebar { flex-basis: 100%; order: 2; }
    #tsp-app h5 { font-size: 12px; }
    #tsp-app #tsp-status, #tsp-app #tsp-summary { font-size: 12px; }
    #tsp-app button#tsp-clear { padding: 8px 16px; font-size: 13px; }
  }
</style>

<div id="tsp-app">
  <div class="tsp-canvas-wrap">
    <canvas id="tsp-canvas" width="417" height="1106"></canvas>
  </div>
  <div class="tsp-sidebar">
    <h5>Plan the middle leg</h5>
    <div id="tsp-status">Your route always starts at &phi; Fibonacci and ends at &mu; Travelling Salesman. Tap the four stops in between, in whatever order you think gives the shortest route.</div>
    <button id="tsp-clear" type="button">Clear my route</button>
    <fieldset>
      <label><input type="radio" name="tsp-show" value="manual" checked> Show: your route</label>
      <label><input type="radio" name="tsp-show" value="optimal"> Show: optimal route</label>
    </fieldset>
    <div id="tsp-summary"></div>
  </div>
</div>

<script>
(function () {
  "use strict";
  if (window.SHOW_JS_APPS === false) return;

  var root = document.getElementById("tsp-app");
  if (!root) return;

  // -------------------------------------------------------------------
  // Travelling Salesman mini-game, ported 1:1 from the Python/Shinylive
  // version (PythonForApps/salesman_py.qmd) to plain JavaScript +
  // <canvas>. Runs entirely in the browser, no Python runtime required.
  //
  // Six trail stops, drawn as coloured circles baked into
  // tsp_game_map.png (a cropped, portrait piece of the full trail map):
  // stop 0 (phi, Fibonacci) is the fixed START, stop 5 (mu, Travelling
  // Salesman) is the fixed END. The player's job is to find the
  // shortest order to visit the four stops in between -- with only 4
  // stops to permute there are 24 possible orderings, small enough to
  // check every single one, which is exactly what "optimal route" does.
  // -------------------------------------------------------------------

  var STOPS = [
    [106.5, 803.9],   // 0. Fibonacci -- START (fixed)
    [152.5, 1035.2],  // 1. Phyllotaxis
    [163.0, 312.0],   // 2. Analemma
    [214.6, 626.9],   // 3. Konigsberg
    [311.5, 71.5],    // 4. Curvature
    [289.7, 306.0]    // 5. Travelling Salesman -- END (fixed)
  ];
  var START_IDX = 0;
  var END_IDX = 5;
  var MIDDLE_IDXS = [1, 2, 3, 4];
  var CIRCLE_R = 26;
  var CLICK_TOLERANCE = CIRCLE_R + 12;

  function dist(a, b) {
    return Math.hypot(STOPS[a][0] - STOPS[b][0], STOPS[a][1] - STOPS[b][1]);
  }

  function openRouteLength(order) {
    var total = 0;
    for (var i = 0; i < order.length - 1; i++) total += dist(order[i], order[i + 1]);
    return total;
  }

  function permutations(arr) {
    if (arr.length <= 1) return [arr];
    var result = [];
    for (var i = 0; i < arr.length; i++) {
      var rest = arr.slice(0, i).concat(arr.slice(i + 1));
      permutations(rest).forEach(function (p) { result.push([arr[i]].concat(p)); });
    }
    return result;
  }

  function bestMiddleOrder() {
    var best = null, bestLen = Infinity;
    permutations(MIDDLE_IDXS).forEach(function (perm) {
      var order = [START_IDX].concat(perm).concat([END_IDX]);
      var len = openRouteLength(order);
      if (len < bestLen) { bestLen = len; best = order; }
    });
    return { order: best, length: bestLen };
  }

  var OPTIMAL = bestMiddleOrder();

  function nearestStop(cx, cy) {
    var bestI = null, bestD = CLICK_TOLERANCE;
    for (var i = 0; i < STOPS.length; i++) {
      var d = Math.hypot(STOPS[i][0] - cx, STOPS[i][1] - cy);
      if (d < bestD) { bestI = i; bestD = d; }
    }
    return bestI;
  }

  function init() {
    var canvas = root.querySelector("#tsp-canvas");
    var ctx = canvas.getContext("2d");
    var statusDiv = root.querySelector("#tsp-status");
    var summaryDiv = root.querySelector("#tsp-summary");
    var clearBtn = root.querySelector("#tsp-clear");
    var showRadios = root.querySelectorAll('input[name="tsp-show"]');

    var img = new Image();
    var imgReady = false;
    var manualRoute = []; // indices of MIDDLE_IDXS the player has tapped, in order

    function currentShow() {
      var checked = root.querySelector('input[name="tsp-show"]:checked');
      return checked ? checked.value : "manual";
    }

    function manualOrder() {
      var complete = manualRoute.length === MIDDLE_IDXS.length;
      return [START_IDX].concat(manualRoute).concat(complete ? [END_IDX] : []);
    }

    function render() {
      if (!imgReady) return;
      var W = canvas.width, H = canvas.height;
      ctx.clearRect(0, 0, W, H);
      ctx.drawImage(img, 0, 0, W, H);

      var show = currentShow();
      var routeToDraw, colour;
      if (show === "optimal") {
        routeToDraw = OPTIMAL.order;
        colour = "#ffb703";
      } else {
        routeToDraw = manualOrder();
        colour = "#1d3557";
      }

      if (routeToDraw.length >= 2) {
        ctx.beginPath();
        ctx.strokeStyle = colour;
        ctx.lineWidth = 4;
        ctx.lineCap = "round";
        ctx.lineJoin = "round";
        for (var i = 0; i < routeToDraw.length; i++) {
          var p = STOPS[routeToDraw[i]];
          if (i === 0) ctx.moveTo(p[0], p[1]); else ctx.lineTo(p[0], p[1]);
        }
        ctx.stroke();
      }

      if (show !== "optimal") {
        manualRoute.forEach(function (idx, orderPos) {
          var p = STOPS[idx];
          var bx = p[0], by = p[1] - 40;
          ctx.beginPath();
          ctx.fillStyle = "#ffffff";
          ctx.strokeStyle = "#1d3557";
          ctx.lineWidth = 2;
          ctx.arc(bx, by, 13, 0, 2 * Math.PI);
          ctx.fill();
          ctx.stroke();
          ctx.fillStyle = "#1d3557";
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          ctx.font = "bold 14px -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif";
          ctx.fillText(String(orderPos + 1), bx, by + 1);
        });
      }

      updateSummary();
    }

    function updateSummary() {
      var lines = [];
      lines.push("Middle stops placed: " + manualRoute.length + " of " + MIDDLE_IDXS.length);
      lines.push("Possible orderings: 24");
      lines.push("");
      lines.push("Optimal route: " + Math.round(OPTIMAL.length) + " units");

      if (manualRoute.length === MIDDLE_IDXS.length) {
        var length = openRouteLength(manualOrder());
        lines.push("Your route: " + Math.round(length) + " units");
        var pct = OPTIMAL.length > 0 ? 100 * (length - OPTIMAL.length) / OPTIMAL.length : 0;
        if (pct > 0.5) {
          lines.push("  " + pct.toFixed(1) + "% longer than optimal");
        } else {
          lines.push("  you found the optimal route!");
        }
      } else {
        lines.push("Tap the four middle stops to complete your route.");
      }
      summaryDiv.textContent = lines.join("\n");
    }

    function handleTap(clientX, clientY) {
      var rect = canvas.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;
      var xCss = clientX - rect.left;
      var yCss = clientY - rect.top;
      var cx = xCss * (canvas.width / rect.width);
      var cy = yCss * (canvas.height / rect.height);

      var idx = nearestStop(cx, cy);
      if (idx === null || idx === START_IDX || idx === END_IDX) return; // start/end are fixed
      if (manualRoute.indexOf(idx) !== -1 || manualRoute.length >= MIDDLE_IDXS.length) return;
      manualRoute.push(idx);
      render();
    }

    canvas.addEventListener("pointerdown", function (evt) {
      evt.preventDefault();
      handleTap(evt.clientX, evt.clientY);
    });

    clearBtn.addEventListener("click", function () {
      manualRoute = [];
      render();
    });

    showRadios.forEach(function (r) {
      r.addEventListener("change", render);
    });

    img.onload = function () {
      imgReady = true;
      render();
    };
    img.src = "tsp_game_map.png";
  }

  init();
})();
</script>
```

Tap the four middle stops on the map above to build your route, then switch the sidebar toggle to compare it with the optimal one.
:::

:::
