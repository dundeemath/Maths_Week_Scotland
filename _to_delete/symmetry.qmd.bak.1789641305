    background: #eee;
    color: #555;
    border: 1px solid #ddd;
  }
  #sym-app .sym-ref-chip.hit {
    background: #f0a500;
    color: #fff;
    border-color: #d18f00;
    font-weight: 600;
  }
  #sym-app label.sym-theory-toggle {
    display: block;
    font-size: 13px;
